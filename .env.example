APP_ENV=dev
APP_DEBUG=1
APP_URL=http://localhost:8000
# Subdirectory on the server, e.g. /~login/ztraty (empty when served from the domain root)
BASE_PATH=

DB_HOST=localhost
DB_NAME=ztraty_nalezy
DB_USER=
DB_PASS=

# log = write mail to storage/logs/mail.log, mail = PHP mail()
MAIL_DRIVER=log
MAIL_FROM=noreply@example.com
