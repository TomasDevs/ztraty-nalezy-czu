APP_ENV=dev
APP_DEBUG=1
# Origin without BASE_PATH
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Prague
# Subdirectory on the server, e.g. /~login/ztraty (empty when served from the domain root)
BASE_PATH=

# mysql = MariaDB below, json = files in storage/data (hosting without database access)
DATA_DRIVER=mysql

DB_HOST=localhost
DB_NAME=ztraty_nalezy
DB_USER=
DB_PASS=

# log = write mail to storage/logs/mail.log, mail = PHP mail()
MAIL_DRIVER=log
MAIL_FROM=noreply@example.com
